# Copy to .env and fill in. Never commit the real file.
# ──────────────────────────────────────────────────────────────
#  Focus Keyword — universal configuration
#  This single file feeds both the DB connection layer (api/conn.php)
#  and the authentication gate (auth.php).
# ──────────────────────────────────────────────────────────────

# ── Login (single shared account) ──
# APP_PASS is the simplest option (plain text).
# For better security set APP_PASS_HASH instead (a password_hash() value)
# and it will take priority over APP_PASS.
APP_USER=
APP_PASS=
# APP_PASS_HASH=   (output of password_hash())

# ── Healthray (live, remote) ──
DB_HEALTHRAY_HOST=
DB_HEALTHRAY_USER=
DB_HEALTHRAY_PASS=
DB_HEALTHRAY_NAME=
DB_HEALTHRAY_PORT=

# ── Botphonic (live, remote) ──
DB_BOTPHONIC_HOST=
DB_BOTPHONIC_USER=
DB_BOTPHONIC_PASS=
DB_BOTPHONIC_NAME=
DB_BOTPHONIC_PORT=

# ── Local (local XAMPP / universal) ──
DB_LOCAL_HOST=
DB_LOCAL_USER=
DB_LOCAL_PASS=
DB_LOCAL_NAME=
DB_LOCAL_PORT=
